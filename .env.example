# Apache NiFi 2.7.2 single-user instance (HTTPS on the host).
NIFI_API_URL=https://127.0.0.1:8443/nifi-api
NIFI_USERNAME=admin
NIFI_PASSWORD=

# The official NiFi image uses a self-signed certificate.
NIFI_VERIFY_SSL=false

# Windows Internet Options proxy breaks TLS to 127.0.0.1. Set true only if NiFi is reached through it.
NIFI_USE_SYSTEM_PROXY=false

# NiFi Registry published on host port 18081 (container 18080). Read-only.
# Set false to hide the Registry tools when the Registry container is not running.
NIFI_REGISTRY_ENABLED=true
NIFI_REGISTRY_API_URL=http://127.0.0.1:18081/nifi-registry-api

# Exact patch 2.7.2 is silent. Other 2.7.x releases warn and continue.
# Anything outside NiFi 2.7 is rejected.
NIFI_EXPECTED_VERSION=2.7.2
